# Culé XI environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything else is server only.

# --- Supabase ---
# Project URL and anon (public) key: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key bypasses row-level security. Used only by server-side sync jobs.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # server only

# --- Highlightly (football data) ---
# Free key from https://highlightly.net (direct API, not RapidAPI). Free plan: 100 requests/day.
HIGHLIGHTLY_API_KEY=your-highlightly-api-key                # server only
HIGHLIGHTLY_BASE_URL=https://soccer.highlightly.net
# Highlightly ids (NOT the same as other providers). Leave blank and run `pnpm check:api`:
# it looks them up and prints the lines to paste here.
BARCA_TEAM_ID=
LALIGA_LEAGUE_ID=
UCL_LEAGUE_ID=
COPA_DEL_REY_LEAGUE_ID=      # optional; leave blank to skip Copa matches
# Season = the year the season STARTS (2026 = the 2026/27 season).
CURRENT_SEASON=2026

# --- App ---
# Public base URL; used for magic-link redirects.
APP_URL=http://localhost:3000
# Comma-separated emails that are granted admin rights on sign-in.
ADMIN_EMAILS=you@example.com  # comma-separated
# Shared code friends enter on /join to join the league.
INVITE_CODE=change-me
# Bearer token that protects the scheduled /api/sync/* endpoints (Vercel Cron sends it automatically).
CRON_SECRET=change-me         # protects the scheduled sync endpoints
